# ─── Project ───────────────────────────────────────────────────────────────────
PROJECT_NAME="Hospital Multi-Agent AI Coordination Platform"
VERSION="1.0.0"
ENVIRONMENT=local

# ─── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe-64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=hospital_pass
POSTGRES_DB=hospital_db
DATABASE_URL=postgresql+asyncpg://hospital_user:hospital_pass@localhost:5432/hospital_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ─── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── AI Provider Keys (add as many as needed) ──────────────────────────────────
GEMINI_KEY_1=your-gemini-key-1
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

OPENROUTER_KEY=your-openrouter-key
QWEN_KEY=your-qwen-key
DEEPSEEK_KEY=your-deepseek-key
GROK_KEY=your-grok-key
OPENAI_KEY=your-openai-key
CLAUDE_KEY=your-claude-key

# ─── AI Model Config ───────────────────────────────────────────────────────────
DEFAULT_SIMPLE_MODEL=gemini-1.5-flash
DEFAULT_MEDIUM_MODEL=gemini-1.5-flash
DEFAULT_COMPLEX_MODEL=gemini-1.5-pro
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
